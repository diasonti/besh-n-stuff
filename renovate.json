{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePresets": [
    "group:monorepos",
    "group:recommended"
  ],
  "enabledManagers": [
    "gradle",
    "gradle-wrapper",
    "github-actions",
    "custom.regex"
  ],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.sdkmanrc$/"],
      "matchStrings": ["(^|\\n)java=(?<currentValue>\\S+-tem)(\\r?\\n|$)"],
      "depNameTemplate": "java",
      "datasourceTemplate": "custom.sdkman",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:\\+(?<revision>\\d+))?-tem$"
    }
  ],
  "customDatasources": {
    "sdkman": {
      "defaultRegistryUrlTemplate": "https://api.sdkman.io/2/candidates/{{{packageName}}}/linuxx64/versions/all",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [$split($join(releases.version, ','), ',').{\"version\": $}]}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Keep dependencies manually managed.",
      "matchManagers": ["gradle"],
      "enabled": false
    },
    {
      "description": "Allow update PRs for Gradle plugins only.",
      "matchManagers": ["gradle"],
      "matchDepTypes": ["plugin"],
      "enabled": true
    },
    {
      "description": "Keep SDKMAN Java on Temurin 21.",
      "matchDatasources": ["custom.sdkman"],
      "matchPackageNames": ["java"],
      "allowedVersions": "/^21\\./"
    }
  ]
}
